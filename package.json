{
  "name": "tonezone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "images": "node scripts/fetch-images.mjs",
    "details": "node scripts/fetch-details.mjs",
    "images:missing": "node scripts/missing-images.mjs",
